---
import { siteConfig, resolveHref } from "../config";
import { forgePackages } from "../forge-ecosystem";
import GitHubIcon from "./GitHubIcon.astro";

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="mt-8 border-t border-border/50 bg-card/30 backdrop-blur-sm">
  <div class="mx-auto max-w-6xl px-6 py-8">
    <div class="grid gap-8 sm:grid-cols-4">
      <!-- Brand -->
      <div>
        <div class="mb-3 flex items-center gap-2">
          <div class="flex size-6 items-center justify-center rounded bg-orange-500/10 font-mono text-[10px] font-semibold text-orange-600 dark:bg-amber-400/10 dark:text-amber-400">
            FI
          </div>
          <span class="text-sm font-semibold text-foreground">{siteConfig.name}</span>
        </div>
        <p class="text-xs leading-relaxed text-muted-foreground">
          {siteConfig.description}.<br />
          Open source under MIT license.
        </p>
      </div>

      <!-- Docs links -->
      <div>
        <h4 class="mb-3 font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">Documentation</h4>
        <ul class="space-y-1.5">
          {siteConfig.nav.docs.flatMap((item) =>
            "href" in item ? [item] : item.children
          ).slice(0, 4).map((item) => (
            <li>
              <a href={resolveHref(item.href)} class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Forge Ecosystem -->
      <div>
        <h4 class="mb-3 font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">Forge Ecosystem</h4>
        <ul class="space-y-1.5">
          {forgePackages.map((pkg) => (
            <li>
              {pkg.name === siteConfig.name ? (
                <span class="text-xs text-amber-400">{pkg.name}</span>
              ) : (
                <a href={pkg.url} class="text-xs text-muted-foreground transition-colors hover:text-foreground">{pkg.name}</a>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h4 class="mb-3 font-mono text-[10px] font-medium uppercase tracking-widest text-muted-foreground">Links</h4>
        <ul class="space-y-1.5">
          <li>
            <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
              GitHub
            </a>
          </li>
          <li>
            <a href={`${siteConfig.github}/issues`} target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
              Report an Issue
            </a>
          </li>
          <li>
            <a href={`${siteConfig.github}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
              MIT License
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 flex flex-col items-center justify-between gap-2 border-t border-border/50 pt-6 sm:flex-row">
      <p class="text-[11px] text-muted-foreground">
        &copy; {year} {siteConfig.name}. All rights reserved.
      </p>
      <div class="flex gap-4">
        <a href={resolveHref("privacy")} class="text-[11px] text-muted-foreground transition-colors hover:text-foreground">Privacy Policy</a>
        <a href={resolveHref("terms")} class="text-[11px] text-muted-foreground transition-colors hover:text-foreground">Terms and Conditions</a>
      </div>
    </div>
  </div>
</footer>
