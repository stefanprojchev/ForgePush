---
// Auto-populated via client-side script from h2 elements in the article
---

<aside class="hidden w-48 shrink-0 xl:block">
  <nav class="sticky top-20">
    <h3 class="mb-3 font-mono text-[11px] font-medium uppercase tracking-widest text-muted-foreground">On this page</h3>
    <ul class="space-y-0.5" id="toc-list"></ul>
  </nav>
</aside>

<script>
  function initToc() {
    const list = document.getElementById("toc-list");
    if (!list) return;

    // Clear existing items safely
    while (list.firstChild) {
      list.removeChild(list.firstChild);
    }

    const article = document.querySelector("article");
    if (!article) return;

    const headings = article.querySelectorAll("h2");
    if (!headings.length) {
      list.closest("aside")?.classList.add("hidden");
      return;
    }

    // Build TOC from h2 elements
    headings.forEach((h2) => {
      if (!h2.id) {
        h2.id = (h2.textContent || "").trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
      }

      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `#${h2.id}`;
      a.textContent = (h2.textContent || "").trim();
      a.className = "toc-link block rounded-md px-2 py-1 text-[12px] leading-snug text-muted-foreground transition-colors hover:text-foreground";
      a.dataset.slug = h2.id;
      li.appendChild(a);
      list.appendChild(li);
    });

    // Scroll spy
    const links = list.querySelectorAll<HTMLAnchorElement>(".toc-link");
    let active: HTMLAnchorElement | null = null;

    function setActive(link: HTMLAnchorElement) {
      if (active === link) return;
      active?.classList.remove("text-amber-400", "font-medium");
      link.classList.add("text-amber-400", "font-medium");
      active = link;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        let best: Element | null = null;
        let bestTop = Infinity;

        for (const entry of entries) {
          if (entry.isIntersecting) {
            const top = entry.boundingClientRect.top;
            if (top >= 0 && top < bestTop) {
              bestTop = top;
              best = entry.target;
            }
          }
        }

        if (!best) {
          // If none have positive top, take the last one that's intersecting
          for (const entry of entries) {
            if (entry.isIntersecting) best = entry.target;
          }
        }

        if (best) {
          const match = Array.from(links).find((l) => l.dataset.slug === best!.id);
          if (match) setActive(match);
        }
      },
      { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
    );

    headings.forEach((h2) => observer.observe(h2));

    // Set first as active initially
    if (links.length) setActive(links[0]);
  }

  initToc();
  document.addEventListener("astro:after-swap", initToc);
</script>
