---
import { siteConfig, resolveHref } from "../config";
import GitHubIcon from "./GitHubIcon.astro";

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const normalizedBase = base.replace(/\/$/, "");

const isHome = currentPath === normalizedBase;

function isActive(section: string) {
  return currentPath.includes(`/${section}/`);
}

const navLinks = [
  { label: "Home", href: base, active: isHome },
  { label: "Docs", href: resolveHref("docs/getting-started"), active: isActive("docs") },
  { label: "Examples", href: resolveHref("examples/basic-app"), active: isActive("examples") },
];
---

<header class="sticky top-0 z-50 border-b border-border/50 bg-background/70 backdrop-blur-xl">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
    <a href={base} class="group flex items-center gap-2.5">
      <div class="flex size-7 items-center justify-center rounded-md bg-orange-500/10 font-mono text-xs font-semibold text-orange-600 transition-colors group-hover:bg-orange-500/20 dark:bg-amber-400/10 dark:text-amber-400 dark:group-hover:bg-amber-400/20">
        FI
      </div>
      <span class="font-semibold tracking-tight text-foreground">{siteConfig.name}</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-md px-3 py-1.5 text-sm font-medium transition-colors",
            link.active
              ? "text-orange-500 dark:text-amber-400"
              : "text-muted-foreground hover:text-foreground",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        <GitHubIcon />
        GitHub
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-toggle"
      class="rounded-md p-2 text-muted-foreground transition-colors hover:text-foreground md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="size-5 menu-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="size-5 menu-close hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-menu" class="hidden border-t border-border/50 bg-background/95 backdrop-blur-xl md:hidden">
    <div class="mx-auto max-w-6xl space-y-1 px-6 py-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "block rounded-md px-3 py-2 text-sm font-medium transition-colors",
            link.active
              ? "bg-accent text-orange-500 dark:text-amber-400"
              : "text-muted-foreground hover:bg-accent hover:text-foreground",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      >
        <GitHubIcon />
        GitHub
      </a>
    </div>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const openIcon = toggle?.querySelector(".menu-open");
    const closeIcon = toggle?.querySelector(".menu-close");

    toggle?.addEventListener("click", () => {
      const isOpen = menu?.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(isOpen));
      openIcon?.classList.toggle("hidden", isOpen);
      closeIcon?.classList.toggle("hidden", !isOpen);
    });
  }

  initMobileMenu();
  document.addEventListener("astro:after-swap", initMobileMenu);
</script>
