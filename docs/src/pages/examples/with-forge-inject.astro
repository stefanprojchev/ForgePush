import PageNavigation from "../../components/PageNavigation.astro";

const registrationCode = `import ForgeInject
import ForgePushToken
import ForgeSilentPush
import ForgeVisiblePush

struct PushDependencies: ForgeRegisterProtocol {
    func registerDependencies(in container: ForgeContainerProtocol) {
        container.register(with: .singleton) { _ in
            PushTokenManager() as PushTokenManager
        }

        container.register(with: .singleton) { container in
            let router = SilentPushRouter(
                connectivity: connectivityObserver,
                protectedData: protectedDataObserver
            )
            router.addHandler(TaskSyncHandler())
            router.addHandler(ReminderUpdateHandler())
            return router as SilentPushRouter
        }

        container.register(with: .singleton) { _ in
            let router = VisiblePushRouter(
                connectivity: connectivityObserver,
                protectedData: protectedDataObserver
            )
            router.addHandler(TaskTappedHandler())
            return router as VisiblePushRouter
        }
    }
}`;

const appDelegateCode = `import UIKit
import ForgeInject
import ForgePushPermission
import ForgePushToken
import ForgeSilentPush
import ForgeVisiblePush

@main
class AppDelegate: UIResponder, UIApplicationDelegate, UNUserNotificationCenterDelegate {
    @ForgeInject var tokenManager: PushTokenManager
    @ForgeInject var silentRouter: SilentPushRouter
    @ForgeInject var visibleRouter: VisiblePushRouter

    func application(
        _ application: UIApplication,
        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?
    ) -> Bool {
        // Set up the container
        let container = ForgeContainer()
        PushDependencies().registerDependencies(in: container)
        ForgeContainer.shared = container

        UNUserNotificationCenter.current().delegate = self

        Task {
            let permission = PushPermission()
            try await permission.request()
            await tokenManager.registerForRemoteNotifications()
        }

        return true
    }

    func application(_ application: UIApplication,
        didRegisterForRemoteNotificationsWithDeviceToken deviceToken: Data) {
        tokenManager.didRegister(deviceToken: deviceToken)
    }

    func application(_ application: UIApplication,
        didFailToRegisterForRemoteNotificationsWithError error: Error) {
        tokenManager.didFailToRegister(error: error)
    }

    func application(_ application: UIApplication,
        didReceiveRemoteNotification userInfo: [AnyHashable: Any],
        fetchCompletionHandler completionHandler: @escaping (UIBackgroundFetchResult) -> Void) {
        silentRouter.handlePush(payload: userInfo, completionHandler: completionHandler)
    }

    func userNotificationCenter(
        _ center: UNUserNotificationCenter,
        didReceive response: UNNotificationResponse,
        withCompletionHandler completionHandler: @escaping () -> Void
    ) {
        visibleRouter.handleResponse(response, completionHandler: completionHandler)
    }

    func userNotificationCenter(
        _ center: UNUserNotificationCenter,
        willPresent notification: UNNotification,
        withCompletionHandler completionHandler: @escaping (UNNotificationPresentationOptions) -> Void
    ) {
        completionHandler([.banner, .sound, .badge])
    }
}`;

const viewModelCode = `import ForgeInject
import ForgePushToken

@Observable
final class TaskFlowSettingsViewModel {
    @ForgeInject var tokenManager: PushTokenManager

    var currentToken: String? { tokenManager.token }

    func startTokenObservation() {
        Task {
            for await token in tokenManager.tokenStream {
                if let token {
                    try? await TaskFlowAPI.shared.registerDevice(token: token)
                }
            }
        }
    }
}`;
