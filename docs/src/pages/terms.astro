---
import LegalLayout from "../layouts/LegalLayout.astro";

const sections = [
  { id: "license", title: "License" },
  { id: "documentation", title: "Documentation" },
  { id: "no-warranty", title: "No Warranty" },
  { id: "contact", title: "Contact" },
];
---

<LegalLayout title="Terms and Conditions" sections={sections}>
  <h1>Terms and Conditions</h1>
  <p class="text-muted-foreground">Last updated: March 2026</p>

  <h2 id="license">License</h2>
  <p>ForgeInject is released under the <a href="https://github.com/stefanprojchev/ForgeInject/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a>. You are free to use, modify, and distribute the library in both commercial and non-commercial projects.</p>

  <h2 id="documentation">Documentation</h2>
  <p>The content on this documentation site is provided as-is for informational purposes. Code examples are intended as guidance and may need adaptation for your specific use case.</p>

  <h2 id="no-warranty">No Warranty</h2>
  <p>The software is provided "as is", without warranty of any kind, express or implied. See the full MIT License for details.</p>

  <h2 id="contact">Contact</h2>
  <p>For questions, open an issue on <a href="https://github.com/stefanprojchev/ForgeInject" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
</LegalLayout>
