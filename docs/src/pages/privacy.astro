---
import LegalLayout from "../layouts/LegalLayout.astro";

const sections = [
  { id: "overview", title: "Overview" },
  { id: "analytics", title: "Analytics" },
  { id: "third-party-services", title: "Third-Party Services" },
  { id: "contact", title: "Contact" },
];
---

<LegalLayout title="Privacy Policy" sections={sections}>
  <h1>Privacy Policy</h1>
  <p class="text-muted-foreground">Last updated: March 2026</p>

  <h2 id="overview">Overview</h2>
  <p>ForgeInject is an open-source Swift library. This documentation website does not collect, store, or process any personal data.</p>

  <h2 id="analytics">Analytics</h2>
  <p>This site does not use analytics, cookies, or tracking scripts of any kind.</p>

  <h2 id="third-party-services">Third-Party Services</h2>
  <p>This site is hosted on GitHub Pages. GitHub may collect basic server logs (IP address, browser type) as part of their hosting infrastructure. See <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub's Privacy Statement</a> for details.</p>
  <p>Fonts are self-hosted and served directly from this domain. No external font services are used.</p>

  <h2 id="contact">Contact</h2>
  <p>For questions about this policy, open an issue on <a href="https://github.com/stefanprojchev/ForgeInject" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
</LegalLayout>
