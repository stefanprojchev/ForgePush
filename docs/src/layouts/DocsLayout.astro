---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { siteConfig, proseClasses } from "../config";

interface Props {
  title: string;
  description?: string;
  section: "docs" | "examples";
}

const { title, description, section } = Astro.props;
const items = section === "docs" ? siteConfig.nav.docs : siteConfig.nav.examples;
const sectionLabel = section === "docs" ? "Documentation" : "Examples";
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto flex max-w-6xl gap-8 px-6 pt-12 pb-20 lg:gap-10">
    <Sidebar items={items} section={sectionLabel} />
    <main class="min-w-0 flex-1">
      <article class={proseClasses}>
        <slot />
      </article>
    </main>
    <TableOfContents />
  </div>
</BaseLayout>
