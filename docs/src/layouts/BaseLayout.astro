---
import "../styles/starwind.css";
import "@fontsource/dm-sans/300.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-sans/700.css";
import "@fontsource-variable/jetbrains-mono";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.name}` : siteConfig.name;
const pageDescription = description || siteConfig.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <meta property="og:image" content={new URL(`${base}/og.svg`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(`${base}/og.svg`, Astro.site).href} />
  </head>
  <body class="relative min-h-screen bg-background font-sans text-foreground antialiased">
    <!-- Site-wide ambient background -->
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,var(--ambient-top),transparent_70%)]" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_80%_50%,var(--ambient-side),transparent_60%)]" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_20%_80%,var(--ambient-bottom),transparent_60%)]" />
    </div>

    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style>
  body {
    --ambient-top: oklch(0.55 0.12 55 / 0.06);
    --ambient-side: oklch(0.50 0.10 40 / 0.04);
    --ambient-bottom: oklch(0.52 0.10 65 / 0.04);
  }
</style>
